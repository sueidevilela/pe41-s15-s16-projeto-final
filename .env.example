# =====================================================================
# Modelo de variáveis do CUIDAR (v7).
# Copie para ".env" (na mesma pasta) e preencha VOCÊ MESMA.
# Este arquivo vai para o GitHub e por isso NUNCA tem valores reais.
# =====================================================================

# ---------- Servidor local ----------
# Porta do servidor local (o padrão é 3000)
# PORT=3000

# ---------- IA da Anthropic (OPCIONAL, só no seu computador) ----------
# Deixe VAZIO: o Tradutor funciona em modo biblioteca, com custo zero.
# A versão publicada na Vercel NÃO usa esta chave.
ANTHROPIC_API_KEY=

# ---------- Supabase (para o script de testes de segurança) ----------
# Valores públicos: os mesmos que estão em js/config.js
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---------- Contas FICTÍCIAS criadas no painel (Authentication > Users) ----------
# A = paciente, B = intrusa, C = cuidadora da paciente A
TESTE_A_EMAIL=
TESTE_A_SENHA=
TESTE_B_EMAIL=
TESTE_B_SENHA=
TESTE_C_EMAIL=
TESTE_C_SENHA=
