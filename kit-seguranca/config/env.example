# Modelo de variáveis do CUIDAR.
# Copie para ".env" e preencha VOCÊ MESMA. Este arquivo (.env.example)
# vai para o GitHub e por isso NUNCA tem valores reais.

# ---------- Front (públicas: podem aparecer no navegador) ----------
SUPABASE_URL=
# Chave pública: sb_publishable_... (ou a "anon" antiga)
SUPABASE_PUBLISHABLE_KEY=

# ---------- Servidor (secretas: NUNCA no front, NUNCA no GitHub) ----------
# Chave secreta: sb_secret_... (ou a "service_role" antiga).
# Só para scripts de carga da biblioteca, rodados na sua máquina.
SUPABASE_SECRET_KEY=

# ---------- Edge function "tradutor" (cadastrar com supabase secrets set) ----------
ANTHROPIC_API_KEY=
TRADUTOR_MODELO=
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------- Automação (se existir) ----------
WHATSAPP_TOKEN=

# ---------- Testes de segurança (contas FICTÍCIAS criadas no painel) ----------
TESTE_A_EMAIL=
TESTE_A_SENHA=
TESTE_B_EMAIL=
TESTE_B_SENHA=
