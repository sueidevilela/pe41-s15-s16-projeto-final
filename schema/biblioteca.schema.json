{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Biblioteca do Tradutor da Saúde — CUIDAR",
  "type": "object",
  "required": ["versao", "atualizado_em", "aviso", "verbetes"],
  "properties": {
    "versao": {"type": "string"},
    "atualizado_em": {"type": "string", "format": "date"},
    "aviso": {"type": "string"},
    "verbetes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "area", "tema", "termos", "explicacao", "o_que_perguntar", "fonte", "tipo_fonte", "data_acesso", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^(tx|cp)-[0-9]{3}$"},
          "area": {"enum": ["transplante", "paliativos"]},
          "tema": {"type": "string", "minLength": 3, "maxLength": 80},
          "termos": {"type": "array", "items": {"type": "string"}, "minItems": 2},
          "explicacao": {"type": "string"},
          "o_que_perguntar": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 3},
          "citacao": {"type": "string"},
          "fonte": {"type": "string"},
          "tipo_fonte": {"enum": ["aberta", "resumo_proprio"]},
          "link": {"type": "string"},
          "data_acesso": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "respaldo": {"type": "string"},
          "origem": {"type": "string"},
          "notas_curadoria": {"type": "string"},
          "status": {"enum": ["rascunho", "revisado"]},
          "revisado_por": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  }
}
